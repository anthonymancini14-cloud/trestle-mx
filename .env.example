# Planning Mode uses Claude when this is set; otherwise a scripted demo planner.
ANTHROPIC_API_KEY=
# Optional model override (default: claude-sonnet-5-5)
# ANTHROPIC_MODEL=claude-sonnet-5-5

# AI tasks other than Planning Mode run on a local model. Any OpenAI-style server works
# (LM Studio, Ollama, llama.cpp, vLLM). Leave empty and the audit queue shows scripted demo runs.
# LOCAL_AI_BASE_URL=http://localhost:1234
# LOCAL_AI_MODEL=
# openai (default) or lmstudio. lmstudio uses LM Studio's own API, which can switch reasoning off.
# LOCAL_AI_API=openai
# lmstudio only: off (default) or auto. Use auto for a model with no reasoning setting.
# LOCAL_AI_REASONING=off
# LOCAL_AI_API_KEY=
# Queue every close-out debrief for extraction.
# AI_AUTO_EXTRACT=on

# Live mode: set both to use Supabase auth + Postgres. Leave empty for the demo plant.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Force demo mode even if Supabase is configured (e.g. for a public demo deployment).
# TRESTLE_MODE=demo

# Only for `pnpm seed:live`, run from your own machine. Never expose to the browser.
# SUPABASE_SERVICE_ROLE_KEY=
# SEED_PASSWORD=
