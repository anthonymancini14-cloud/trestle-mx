# Planning Mode uses Claude when this is set; otherwise a scripted demo planner.
ANTHROPIC_API_KEY=
# Optional model override (default: claude-sonnet-5-5)
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Live mode: set both to use Supabase auth + Postgres. Leave empty for the demo plant.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Force demo mode even if Supabase is configured (e.g. for a public demo deployment).
# TRESTLE_MODE=demo

# Only for `pnpm seed:live`, run from your own machine. Never expose to the browser.
# SUPABASE_SERVICE_ROLE_KEY=
# SEED_PASSWORD=
